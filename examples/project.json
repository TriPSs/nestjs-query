{
  "name": "examples",
  "$schema": "../node_modules/@isox-sh/core/schemas/project.schema.json",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@isox-sh/core:run-command",
      "options": {
        "command": "yarn eslint \"examples/**/*.ts\""
      }
    },
    "e2e": {
      "executor": "@isox-sh/core:run-command",
      "options": {
        "command": "yarn vitest run --config examples/vitest.config.ts"
      }
    }
  },
  "dependencies": ["core", "query-graphql", "query-mongoose", "query-sequelize", "query-typegoose", "query-typeorm"]
}
