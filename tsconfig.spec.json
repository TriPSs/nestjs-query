{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/__tests__/**/*.ts",
    "packages/*/vitest.config.ts",
    "examples/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
