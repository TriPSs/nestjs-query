{
  "name": "workspace",
  "$schema": "node_modules/@isox-sh/core/schemas/project.schema.json",
  "targets": {
    "version": {
      "executor": "@isox-sh/semver:version",
      "options": {
        "syncVersions": true,
        "skipProjectChangelog": true,
        "commitMessageFormat": "chore(release): v{version}"
      },
      "configurations": {
        "production": {
          "postTargets": ["workspace:github"]
        }
      }
    },
    "github": {
      "executor": "@isox-sh/semver:github",
      "options": {
        "tag": "{tag}",
        "notes": "{notes}"
      }
    }
  }
}
