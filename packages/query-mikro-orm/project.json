{
  "name": "query-mikro-orm",
  "$schema": "../../node_modules/@isox-sh/core/schemas/project.schema.json",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@isox-sh/core:run-command",
      "options": {
        "command": "yarn eslint \"packages/query-mikro-orm/**/*.ts\""
      }
    },
    "test": {
      "executor": "@isox-sh/vitest:test",
      "options": {
        "configFile": "packages/query-mikro-orm/vitest.config.ts"
      }
    },
    "build": {
      "executor": "@isox-sh/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/query-mikro-orm"],
      "options": {
        "tsConfig": "packages/query-mikro-orm/tsconfig.lib.json",
        "generatePackageJson": true,
        "assets": [
          {
            "input": "packages/query-mikro-orm",
            "glob": "*.md",
            "ignore": ["README.md", "LICENSE.md"]
          }
        ]
      }
    },
    "publish": {
      "executor": "@isox-sh/core:run-command",
      "options": {
        "command": "npm publish ./dist/packages/query-mikro-orm --access public"
      },
      "configurations": {
        "alpha": {
          "command": "npm publish ./dist/packages/query-mikro-orm --access public --tag alpha"
        }
      }
    },
    "version": {
      "executor": "@isox-sh/semver:version",
      "options": {}
    }
  },
  "dependencies": ["core"]
}
