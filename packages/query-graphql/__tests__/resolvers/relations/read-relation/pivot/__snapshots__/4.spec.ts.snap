  testResolverId
}

"""Sort Directions"""
enum SortDirection {
  ASC
  DESC
}

"""Sort Nulls Options"""
enum SortNulls {
  NULLS_FIRST
  NULLS_LAST
}

type TestRelationDTO {
  id: ID!
  testResolverId: String!
}

type TestPivotDTO {
  since: String!
}

type TestResolverDTORelationsEdge {
  """The node containing the TestRelationDTO"""
  node: TestRelationDTO!

  """Cursor for this node."""
  cursor: ConnectionCursor!

  """
  The properties of the relationship between the parent and the TestRelationDTO
